[Unit]
Description=Photobooth button listener (capture + print)

[Service]
Type=simple
User=photobooth
SupplementaryGroups=lp gpio video
WorkingDirectory=/home/photobooth/photobooth
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/photobooth/photobooth/booth.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
