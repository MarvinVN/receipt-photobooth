[Unit]
Description=Photobooth web editor (Flask)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=photobooth
SupplementaryGroups=lp
WorkingDirectory=/home/photobooth/photobooth
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/photobooth/photobooth/webadmin.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
